{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": true,
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "none",
    "ignorePatterns": [
        ".output.js",
        "node_modules",
        ".vscode",
        "public",
        "*-lock.yaml",
        "docs/.vitepress/cache",
        "docs/.vitepress/dist"
    ],
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2,
                "singleQuote": false
            }
        },
        {
            "files": ["*.css", "*.scss", "*.less"],
            "options": {
                "singleQuote": false
            }
        }
    ]
}
