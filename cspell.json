{
   "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
   "version": "0.2",
   "language": "en,en-US",
   // 复合词检查
   "allowCompoundWords": true,
   // 从cspell的配置文件为当前目录，file patterns为匹配
   "ignorePaths": [
      "**/node_modules/**",
      "pnpm-lock.yaml",
      "**/dist/**",
      ".vscode/**",
      "docs/.vitepress/dist/**",
      "docs/.vitepress/cache/**",
      "docs/.temp/**",
      "docs/public/**",
      "**/*.svg",
      "**/*.png",
      "**/*.ico"
   ],
   // 正确单词列表
   "words": [
      "addii",
      ".browserslistrc",
      "ACMR",
      "Cascader",
      "Contentful",
      "FOUC",
      "Gret",
      "Mydocs",
      "Nihao",
      "SPATTAL",
      "Turborepo",
      "Turw",
      "bradlc",
      "ceintl",
      "chunnel",
      "codepaths",
      "dbaeumer",
      "defu",
      "echarts",
      "emcc",
      "emscripten",
      "envfile",
      "esbenp",
      "esbuild",
      "externel",
      "fastify",
      "gifsicle",
      "iconify",
      "ishide",
      "ishome",
      "jsxdev",
      "libuv",
      "mhutchie",
      "minh",
      "minw",
      "mkdist",
      "mockjs",
      "mozjpeg",
      "mrmlnc",
      "naumovs",
      "ncjs",
      "nihao",
      "nprogress",
      "nuxt",
