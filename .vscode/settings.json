{
  //===== 折叠文件夹（美观优化） =====
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "bun.lock, .gitignore,  .gitattributes, .gitconfig, cspell.json, README.md,postcss.config.js",
    ".prettierrc.json": ".prettierignore, .editorconfig ",
    "CLAUDE.md": "AGENTS.md",
    "CLAUDE-PREVIEW.html": "CLAUDE-PREVIEW.css"
  }
}
